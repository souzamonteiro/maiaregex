/* Authoritative BRE syntax. Finite group-depth productions protect parser stack. */
Input ::= Sequence0 EOF
Sequence0 ::= BeginAnchor? InitialStarPiece? Piece0* EndAnchor?
Piece0 ::= Atom0 Quantifier?
Atom0 ::= Group0 | Class | Any | Reference | Escape | UnsupportedEscape | Literal
Group0 ::= GroupOpen Sequence1 GroupClose
Sequence1 ::= BeginAnchor? InitialStarPiece? Piece1* EndAnchor?
Piece1 ::= Atom1 Quantifier?
Atom1 ::= Group1 | Class | Any | Reference | Escape | UnsupportedEscape | Literal
Group1 ::= GroupOpen Sequence2 GroupClose
Sequence2 ::= BeginAnchor? InitialStarPiece? Piece2* EndAnchor?
Piece2 ::= Atom2 Quantifier?
Atom2 ::= Group2 | Class | Any | Reference | Escape | UnsupportedEscape | Literal
Group2 ::= GroupOpen Sequence3 GroupClose
Sequence3 ::= BeginAnchor? InitialStarPiece? Piece3* EndAnchor?
Piece3 ::= Atom3 Quantifier?
Atom3 ::= Group3 | Class | Any | Reference | Escape | UnsupportedEscape | Literal
Group3 ::= GroupOpen Sequence4 GroupClose
Sequence4 ::= BeginAnchor? InitialStarPiece? Piece4* EndAnchor?
Piece4 ::= Atom4 Quantifier?
Atom4 ::= Group4 | Class | Any | Reference | Escape | UnsupportedEscape | Literal
Group4 ::= GroupOpen Sequence5 GroupClose
Sequence5 ::= BeginAnchor? InitialStarPiece? Piece5* EndAnchor?
Piece5 ::= Atom5 Quantifier?
Atom5 ::= Group5 | Class | Any | Reference | Escape | UnsupportedEscape | Literal
Group5 ::= GroupOpen Sequence6 GroupClose
Sequence6 ::= BeginAnchor? InitialStarPiece? Piece6* EndAnchor?
Piece6 ::= Atom6 Quantifier?
Atom6 ::= Group6 | Class | Any | Reference | Escape | UnsupportedEscape | Literal
Group6 ::= GroupOpen Sequence7 GroupClose
Sequence7 ::= BeginAnchor? InitialStarPiece? Piece7* EndAnchor?
Piece7 ::= Atom7 Quantifier?
Atom7 ::= Group7 | Class | Any | Reference | Escape | UnsupportedEscape | Literal
Group7 ::= GroupOpen Sequence8 GroupClose
Sequence8 ::= BeginAnchor? InitialStarPiece? Piece8* EndAnchor?
Piece8 ::= Atom8 Quantifier?
Atom8 ::= Group8 | Class | Any | Reference | Escape | UnsupportedEscape | Literal
Group8 ::= GroupOpen Sequence9 GroupClose
Sequence9 ::= BeginAnchor? InitialStarPiece? Piece9* EndAnchor?
Piece9 ::= Atom9 Quantifier?
Atom9 ::= DepthOverflow | Class | Any | Reference | Escape | UnsupportedEscape | Literal
DepthOverflow ::= GroupOpen
BeginAnchor ::= CARET
EndAnchor ::= END_DOLLAR
InitialStarPiece ::= InitialStar Quantifier?
InitialStar ::= STAR
GroupOpen ::= BACKSLASH LPAREN
GroupClose ::= BACKSLASH RPAREN
Any ::= DOT
Reference ::= BACKSLASH DIGIT
Escape ::= BACKSLASH (BACKSLASH | DOT | CARET | DOLLAR | END_DOLLAR | OPEN | OPEN_SPECIAL | CLOSE | STAR)
UnsupportedEscape ::= BACKSLASH (PLUS | QUESTION | PIPE | LETTER | CHAR | DASH | COLON | EQUAL | COMMA)
Literal ::= LETTER | DIGIT | CHAR | PLUS | QUESTION | PIPE | LPAREN | RPAREN | LBRACE | RBRACE | DASH | COLON | EQUAL | COMMA | CARET | DOLLAR | CLOSE
Quantifier ::= StarRepeat | ExactRepeat | OpenRepeat | BoundedRepeat
StarRepeat ::= STAR
ExactRepeat ::= BACKSLASH LBRACE Number BACKSLASH RBRACE
OpenRepeat ::= BACKSLASH LBRACE Number COMMA BACKSLASH RBRACE
BoundedRepeat ::= BACKSLASH LBRACE Number COMMA Number BACKSLASH RBRACE
Number ::= DIGIT+
Class ::= ClassOpen Negation? (InitialCloseRange | InitialClose | ClassElement) ClassElement* CLOSE
ClassOpen ::= OPEN | OPEN_SPECIAL
Negation ::= CARET
InitialCloseRange ::= CLOSE DASH ClassScalar
InitialClose ::= CLOSE
ClassElement ::= NamedClass | Collating | Equivalence | Range | ClassScalar
NamedClass ::= OPEN_SPECIAL COLON ClassName COLON CLOSE
ClassName ::= LETTER+
Collating ::= OPEN_SPECIAL DOT CollatingScalar+ DOT CLOSE
Equivalence ::= OPEN_SPECIAL EQUAL EquivalenceScalar+ EQUAL CLOSE
CollatingScalar ::= LETTER | DIGIT | CHAR | PLUS | QUESTION | PIPE | LPAREN | RPAREN | LBRACE | RBRACE | DASH | COLON | EQUAL | COMMA | CARET | DOLLAR | END_DOLLAR | STAR | BACKSLASH | OPEN
EquivalenceScalar ::= LETTER | DIGIT | CHAR | PLUS | QUESTION | PIPE | LPAREN | RPAREN | LBRACE | RBRACE | DASH | COLON | DOT | COMMA | CARET | DOLLAR | END_DOLLAR | STAR | BACKSLASH | OPEN
Range ::= ClassScalar DASH ClassScalar
ClassScalar ::= LETTER | DIGIT | CHAR | PLUS | QUESTION | PIPE | LPAREN | RPAREN | LBRACE | RBRACE | DASH | COLON | DOT | EQUAL | COMMA | CARET | DOLLAR | END_DOLLAR | STAR | BACKSLASH | OPEN
<?TOKENS?>
EOF ::= $
END_DOLLAR ::= #x24 & ($ | #x5C #x29)
OPEN_SPECIAL ::= #x5B & [#x3A#x2E#x3D]
BACKSLASH ::= #x5C
LPAREN ::= #x28
RPAREN ::= #x29
LBRACE ::= #x7B
RBRACE ::= #x7D
OPEN ::= #x5B
CLOSE ::= #x5D
CARET ::= #x5E
DOLLAR ::= #x24
STAR ::= #x2A
DOT ::= #x2E
PLUS ::= #x2B
QUESTION ::= #x3F
PIPE ::= #x7C
DASH ::= #x2D
COLON ::= #x3A
EQUAL ::= #x3D
COMMA ::= #x2C
LETTER ::= [a-z]
DIGIT ::= [0-9]
CHAR ::= [#xD800-#xDBFF] [#xDC00-#xDFFF] | [^#x0#x24#x28#x29#x2A#x2B#x2C#x2D#x2E#x3A#x3D#x3F#x5B#x5C#x5D#x5E#x7B#x7C#x7Da-z0-9#xD800-#xDFFF]
